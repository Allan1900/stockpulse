    sina_code = _us_symbol_to_sina(symbol)
    url = f"https://hq.sinajs.cn/list={sina_code}"
    try:
        resp = _req.get(url, headers=SINA_HEADERS, timeout=8)
        resp.encoding = "gbk"; text = resp.text.strip()
    except Exception as e:
        return {"error": f"美股网络失败: {e}", "source": "us_realtime"}
    m = re.search(r'"([^"]+)"', text)
    if not m: return {"error": "无法解析美股", "source": "us_realtime"}
    fields = m.group(1).split(",")
    if len(fields) < 20: return {"error": "美股字段不足", "source": "us_realtime"}
    def _f(i, d=0.0):
