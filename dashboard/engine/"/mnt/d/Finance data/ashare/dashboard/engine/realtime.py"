def get_hk_realtime_quote(ts_code: str) -> dict:
    symbol = _hk_code_to_sina(ts_code)
    url = f"https://hq.sinajs.cn/list={symbol}"
    try:
        resp = _req.get(url, headers=SINA_HEADERS, timeout=8)
        resp.encoding = "gbk"; text = resp.text.strip()
    except Exception as e:
        return {"error": f"港股网络失败: {e}", "source": "hk_realtime"}
    m = re.search(r'"([^"]+)"', text)
    if not m: return {"error": "无法解析港股", "source": "hk_realtime"}
    fields = m.group(1).split(",")
    if len(fields) < 6: return {"error": "港股字段不足", "source": "hk_realtime"}
    def _f(i, d=0.0):
        try: return float(fields[i]) if fields[i].strip() else d
        except: return d
    name=fields[1]; open_p=_f(2); yest_close=_f(3); high=_f(4); low=_f(5)
    price=_f(6); change_v=_f(7); pct_chg=_f(8)
    volume=int(_f(9,0)); amount=_f(11,0); bid=_f(13,0); ask=_f(14,0)
    ds=fields[17] if len(fields)>17 else ""; ts=fields[18] if len(fields)>18 else ""
    return {"ts_code":ts_code,"name":name,"open":round(open_p,2),
        "yest_close":round(yest_close,2),"price":round(price,2),
        "high":round(high,2),"low":round(low,2),
        "volume":int(volume),"amount":round(amount,2),
        "bid":round(bid,2),"ask":round(ask,2),
        "pct_chg":round(pct_chg,2),"change":round(change_v,2),
        "datetime":f"{ds} {ts}".strip(),"source":"hk_realtime"}

def get_hk_market_snapshot() -> pd.DataFrame:
    import akshare as ak
    try:
        df = ak.stock_hk_spot()
        if df is not None and not df.empty:
            df["ts_code"] = df["代码"].apply(lambda x: str(x).zfill(5)+".HK")
            df["最新价"] = pd.to_numeric(df.get("最新价",0), errors="coerce")
            df["涨跌幅"] = pd.to_numeric(df.get("涨跌幅",0), errors="coerce")
        return df
    except Exception as e:
        return pd.DataFrame({"error":[f"港股快照失败:{e}"]})

