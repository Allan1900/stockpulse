SINA_HEADERS = {"Referer": "https://finance.sina.com.cn",
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"}

def _tscode_to_sina_symbol(ts_code: str) -> str:
    code = ts_code.upper(); base = code.replace(".SZ","").replace(".SH","").strip()
    if code.endswith(".SZ"): return "sz" + base.lower()
    if code.endswith(".SH"): return "sh" + base.lower()
    return ("sh" if base.startswith(("6","9")) else "sz") + base.lower()

def _hk_code_to_sina(ts_code: str) -> str:
    return "hk" + ts_code.upper().replace(".HK","").strip()

# ════════════════════════════════════════════════════════════════
# A股 — 个股实时 (新浪直连, 毫秒级)
# ════════════════════════════════════════════════════════════════

def get_realtime_quote(ts_code: str) -> dict:
    symbol = _tscode_to_sina_symbol(ts_code)
    url = f"https://hq.sinajs.cn/list={symbol}"
    try:
        resp = _req.get(url, headers=SINA_HEADERS, timeout=8)
        resp.encoding = "gbk"; text = resp.text.strip()
    except Exception as e:
        return {"error": f"网络请求失败: {e}", "source": "sina_realtime"}
    m = re.search(r'"([^"]+)"', text)
    if not m: return {"error": "无法解析", "source": "sina_realtime"}
    fields = m.group(1).split(",")
    if len(fields) < 8: return {"error": f"字段不足", "source": "sina_realtime"}
    def _f(i, d=0.0):
        try: return float(fields[i]) if fields[i].strip() else d
        except: return d
    name = fields[0]; open_p=_f(1); yest_close=_f(2); price=_f(3)
    high=_f(4); low=_f(5); bid=_f(6); ask=_f(7)
    volume=_f(8,0); amount=_f(9,0)
    pct_chg = ((price-yest_close)/yest_close*100) if yest_close else 0
    ds = fields[30] if len(fields)>30 else ""; ts = fields[31] if len(fields)>31 else ""
    return {"ts_code":ts_code,"name":name,"open":round(open_p,2),
        "yest_close":round(yest_close,2),"price":round(price,2),
        "high":round(high,2),"low":round(low,2),
        "volume":int(volume),"amount":round(amount,2),
        "bid":round(bid,2),"ask":round(ask,2),
        "pct_chg":round(pct_chg,2),"change":round(price-yest_close,2),
        "datetime":f"{ds} {ts}".strip(),"source":"sina_realtime"}

