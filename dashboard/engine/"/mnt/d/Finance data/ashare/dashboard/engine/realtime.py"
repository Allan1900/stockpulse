"""
实时行情引擎 — 混合架构: 交易时段走实时API, 非交易时段走PG

数据源:
  - A股个股实时: 新浪直连 HTTP (毫秒级)
  - A股全市场快照: 腾讯 stock_zh_a_spot_tx (~6s, 27字段)
  - A股个股分时: 腾讯 stock_zh_a_minute
  - 港股个股实时: 新浪直连 HTTP
  - 港股全市场快照: 新浪 stock_hk_spot (~30s, 2800只)
  - 美股个股实时: 新浪直连 HTTP (毫秒级)
  - 美股日线历史: AKShare stock_us_daily
  - 港股日线历史: AKShare stock_hk_daily
  - 外汇实时: 新浪直连 HTTP
  - 全球指数: 新浪 stock_hk_index_spot_sina
  - 盘后/周末: PostgreSQL
"""
import warnings; warnings.filterwarnings("ignore")
import pandas as pd
import numpy as np
from datetime import datetime, time
import requests as _req
import re

# ════════════════════════════════════════════════════════════════
# 交易时段判断
# ════════════════════════════════════════════════════════════════

TRADING_START = time(9, 30)
TRADING_END = time(15, 0)

def is_trading_time(dt: datetime = None) -> bool:
    dt = dt or datetime.now()
    if dt.weekday() >= 5: return False
    t = dt.time()
    return TRADING_START <= t < TRADING_END

def is_market_open_today() -> bool:
    from engine.query import sql_one
    today_str = datetime.now().strftime("%Y%m%d")
    r = sql_one(None, "SELECT 1 FROM trade_cal WHERE cal_date=%s AND is_open=1", [today_str])
    return r is not None

