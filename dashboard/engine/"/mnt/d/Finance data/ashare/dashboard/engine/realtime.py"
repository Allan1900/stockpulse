# ════════════════════════════════════════════════════════════════
# PG 盘后查询
# ════════════════════════════════════════════════════════════════

def get_pg_quote(ts_code: str) -> dict:
    from engine.query import sql_one
    row = sql_one(None,
        "SELECT trade_date, close, pct_chg, high, low, vol, amount, open, pre_close "
        "FROM daily WHERE ts_code=%s ORDER BY trade_date DESC LIMIT 1", [ts_code])
    if not row: return {"error":f"PG无数据:{ts_code}","source":"pg"}
    nr = sql_one(None, "SELECT name FROM stock_basic WHERE ts_code=%s", [ts_code])
    return {"ts_code":ts_code,"name":nr["name"] if nr else "","trade_date":row["trade_date"],
        "price":float(row["close"]),"pct_chg":float(row["pct_chg"]),
        "high":float(row["high"]),"low":float(row["low"]),
        "volume":int(row["vol"]) if row["vol"] else 0,
        "amount":float(row["amount"]) if row["amount"] else 0,
        "open":float(row["open"]) if row["open"] else 0,
        "yest_close":float(row["pre_close"]) if row["pre_close"] else 0,"source":"pg"}

# ════════════════════════════════════════════════════════════════
# 混合路由
# ════════════════════════════════════════════════════════════════

def hybrid_quote(ts_code: str, force_pg: bool = False) -> dict:
    if not force_pg and is_trading_time():
        result = get_realtime_quote(ts_code)
        if "error" not in result: return result
        fb = get_pg_quote(ts_code)
        fb["fallback_reason"] = result.get("error"); return fb
    return get_pg_quote(ts_code)

def hybrid_market_snapshot() -> pd.DataFrame:
    if is_trading_time():
        snap = get_market_snapshot()
        if snap is not None and not snap.empty and "error" not in snap.columns: return snap
    from engine.query import sql as _sql
    df = _sql(None, """SELECT d.ts_code, s.name, d.close, d.pct_chg, d.vol, d.amount,
        d.high, d.low, d.open, b.pe_ttm, b.pb, b.total_mv,
        b.circ_mv, b.turnover_rate FROM daily d
        JOIN stock_basic s ON d.ts_code = s.ts_code
        LEFT JOIN daily_basic b ON d.ts_code = b.ts_code AND d.trade_date = b.trade_date
        WHERE d.trade_date = (SELECT MAX(trade_date) FROM daily)
        ORDER BY d.amount DESC""")
    if df is not None and not df.empty: df["source"] = "pg"
    return df

# ════════════════════════════════════════════════════════════════
# 市场概览 (4大指数)
# ════════════════════════════════════════════════════════════════

def get_market_overview() -> dict:
    indices = {"000001.SH":"上证指数","399001.SZ":"深证成指",
               "399006.SZ":"创业板指","000688.SH":"科创50"}
    if is_trading_time():
        rows = []
        for code, name in indices.items():
            q = get_realtime_quote(code)
            if "error" not in q:
                rows.append({"指数":q.get("name",name),"最新价":q.get("price",0),
                    "涨跌幅":q.get("pct_chg",0),"涨跌额":q.get("change",0),
                    "今开":q.get("open",0),"最高":q.get("high",0),
                    "最低":q.get("low",0),
                    "成交额(亿)":round(q.get("amount",0)/1e8,2) if q.get("amount") else 0})
        return {"data":pd.DataFrame(rows),"source":"realtime"}
    from engine.query import sql as _sql
    df = _sql(None, """SELECT ts_code, trade_date, close, pct_chg, open, high, low, amount
        FROM index_daily WHERE ts_code = ANY(%s)
        AND trade_date = (SELECT MAX(trade_date) FROM index_daily)""",
        params=[list(indices.keys())])
    if df is not None and not df.empty:
        df["指数"]=df["ts_code"].map(indices); df["最新价"]=df["close"]
        df["涨跌幅"]=df["pct_chg"]; df["今开"]=df["open"]
        df["最高"]=df["high"]; df["最低"]=df["low"]
        df["成交额(亿)"]=(df["amount"]/1e8).round(2)
        df = df[["指数","最新价","涨跌幅","今开","最高","最低","成交额(亿)"]]
        return {"data":df,"source":"pg"}
    return {"data":pd.DataFrame(),"source":"pg"}